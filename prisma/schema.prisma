generator client {
  provider = "prisma-client-js"
}

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
//
// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

model Org {
  partnerOrgLinks    PartnerLink[] @relation("PartnerOrgLinks")
  dealerPartnerLinks PartnerLink[] @relation("DealerPartnerLinks")

  id         String  @id @default(cuid())
  type       OrgType
  name       String
  clerkOrgId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users             UserOrg[]
  deals             Deal[]
  dealEvents        DealEvent[]
  dealDocuments     DealDocument[]
  subscription      OrgSubscription?
  customers         Customer[]
  vehicles          Vehicle[]
  workshopJobs      WorkshopJob[]
  workshopJobNotes  WorkshopJobNote[]
  workshopJobPhotos WorkshopJobPhoto[]

  workshopJobEvents WorkshopJobEvent[]

  // Rentals relations
  rentalQuoteRequests RentalQuoteRequest[]
  rentalBookings RentalBooking[]
  rentalDocuments RentalDocument[]
  rentalDeposits RentalDeposit[]
  rentalIssues RentalIssue[]
  rentalMessageLogs RentalMessageLog[]
  rentalReminders RentalReminder[]
  rentalEvents RentalEvent[]

  @@index([type])
}

enum OrgType {
  DEALER
  PARTNER
  INTERNAL
}

model User {
  id          String  @id @default(cuid())
  email       String  @unique
  name        String?
  clerkUserId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orgs              UserOrg[]
  actedEvents       DealEvent[]    @relation("DealEvent_actorId")
  uploadedDocuments DealDocument[] @relation("DealDocument_uploadedBy")
}

model UserOrg {
  id     String @id @default(cuid())
  userId String
  orgId  String
  role   Role

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
  org  Org  @relation(fields: [orgId], references: [id])

  @@unique([userId, orgId])
  @@index([orgId])
  @@index([userId])
}

enum Role {
  OWNER
  GM
  SALES_MANAGER
  SALES
  FINANCE
  COMPLIANCE
  READ_ONLY
}

model Deal {
  id          String     @id @default(cuid())
  orgId       String
  dealNumber  String
  status      DealStatus @default(NEW)
  customerRef String?
  vehicleRef  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org       Org            @relation(fields: [orgId], references: [id])
  events    DealEvent[]
  documents DealDocument[]
  deposits  Deposit[]
  evidence  EvidenceFile[]
  exports   ExportBundle[]

  @@unique([orgId, dealNumber])
  @@index([orgId, createdAt])
  @@index([orgId, status])
}

enum DealEventType {
  DEAL_CREATED
  DOCUMENT_UPLOADED
  EXPORT_JSON
  EXPORT_HTML
  NOTE
  REVIEWED
  STATUS_CHANGED
  DEPOSIT_APPROVED
}

enum DealDocumentType {
  ID_DOCUMENT
  RESERVATION_FORM
  DEPOSIT_RECEIPT
  VEHICLE_DOCUMENT
  FINANCE_DOCUMENT
  HANDOVER_DOCUMENT
  OTHER
}

enum DealStatus {
  NEW
  RESERVED
  DEPOSIT_RECEIVED
  IN_FINANCE
  COMPLETED
  CANCELLED
}

model DealEvent {
  id        String        @id @default(cuid())
  dealId    String
  orgId     String
  org       Org           @relation(fields: [orgId], references: [id])
  type      DealEventType
  message   String?
  payload   Json?
  ip        String?
  userAgent String?
  createdAt DateTime      @default(now())
  actorId   String?

  deal  Deal  @relation(fields: [dealId], references: [id])
  actor User? @relation("DealEvent_actorId", fields: [actorId], references: [id])

  @@index([dealId, createdAt])
  @@index([orgId, createdAt])
  @@index([actorId])
}

model DealDocument {
  id           String           @id @default(cuid())
  orgId        String
  dealId       String
  fileName     String
  originalName String
  mimeType     String
  fileSize     Int
  documentType DealDocumentType
  storagePath  String
  uploadedBy   String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  org      Org   @relation(fields: [orgId], references: [id])
  deal     Deal  @relation(fields: [dealId], references: [id])
  uploader User? @relation("DealDocument_uploadedBy", fields: [uploadedBy], references: [id])

  @@index([orgId, createdAt])
  @@index([dealId, createdAt])
  @@index([orgId, dealId])
}

model Deposit {
  id        String        @id @default(cuid())
  dealId    String
  amount    Int
  currency  String        @default("AED")
  receiptId String        @unique
  status    DepositStatus @default(RECEIVED)
  createdAt DateTime      @default(now())

  deal Deal @relation(fields: [dealId], references: [id])

  @@index([dealId, createdAt])
}

enum DepositStatus {
  RECEIVED
  REFUNDED
  CANCELLED
}

model EvidenceFile {
  id         String   @id @default(cuid())
  dealId     String
  uploadedBy String?
  filename   String
  mimeType   String
  storageKey String
  sha256     String
  redacted   Boolean  @default(false)
  createdAt  DateTime @default(now())

  deal Deal @relation(fields: [dealId], references: [id])

  @@unique([dealId, storageKey])
  @@index([dealId, createdAt])
}

model ExportBundle {
  id         String   @id @default(cuid())
  dealId     String
  createdBy  String?
  storageKey String
  sha256     String
  createdAt  DateTime @default(now())

  deal Deal @relation(fields: [dealId], references: [id])

  @@unique([dealId, storageKey])
  @@index([dealId, createdAt])
}

model PartnerLink {
  id           String   @id @default(cuid())
  partnerOrgId String
  dealerOrgId  String
  code         String   @unique
  createdAt    DateTime @default(now())

  partnerOrg Org @relation("PartnerOrgLinks", fields: [partnerOrgId], references: [id])
  dealerOrg  Org @relation("DealerPartnerLinks", fields: [dealerOrgId], references: [id])

  @@index([partnerOrgId])
  @@index([dealerOrgId])
}

enum Plan {
  FREE
  PRO
  ELITE
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
}

model OrgSubscription {
  id    String @id @default(cuid())
  orgId String @unique

  plan   Plan               @default(FREE)
  status SubscriptionStatus @default(ACTIVE)

  provider               String? @default("stripe")
  providerCustomerId     String?
  providerSubscriptionId String?

  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([plan])
  @@index([status])
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =============================
// Sovereign Workshop Control v1
// =============================

enum WorkshopJobStatus {
  NEW_ENQUIRY
  BOOKED_IN
  INSPECTION
  ESTIMATE_SENT
  APPROVED
  IN_PROGRESS
  READY_FOR_COLLECTION
  DELIVERED
  ON_HOLD
  CANCELLED
}

enum WorkshopJobPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum WorkshopLeadSource {
  WHATSAPP
  CALL
  WEBSITE
  WALK_IN
  GOOGLE
  INSTAGRAM
  OTHER
}

enum WorkshopPhotoType {
  INTAKE
  DAMAGE
  REPAIR
  COMPLETION
  OTHER
}

enum WorkshopEventType {
  JOB_CREATED
  STATUS_CHANGED
  NOTE_ADDED
  PHOTO_ADDED
  CUSTOMER_CONTACTED
  OTHER
}

model Customer {
  id        String   @id @default(cuid())
  orgId     String
  fullName  String
  phone     String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org          Org           @relation(fields: [orgId], references: [id])
  vehicles     Vehicle[]

  workshopJobs WorkshopJob[]

  // Rentals relations
  rentalQuoteRequests RentalQuoteRequest[]
  rentalBookings RentalBooking[]
  rentalDocuments RentalDocument[]
  rentalIssues RentalIssue[]
  rentalMessageLogs RentalMessageLog[]
  rentalEvents RentalEvent[]

  @@index([orgId])
}

model Vehicle {
  id          String   @id @default(cuid())
  orgId       String
  customerId  String
  make        String
  model       String
  year        Int?
  plateNumber String?
  vin         String?
  color       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org          Org           @relation(fields: [orgId], references: [id])
  customer     Customer      @relation(fields: [customerId], references: [id])

  workshopJobs WorkshopJob[]


  // Rentals relations
  rentalBookings RentalBooking[]
}

model WorkshopJob {
  id         String              @id @default(cuid())
  orgId      String
  customerId String
  vehicleId  String
  title      String
  complaint  String?
  status     WorkshopJobStatus   @default(NEW_ENQUIRY)
  priority   WorkshopJobPriority @default(NORMAL)
  source     WorkshopLeadSource  @default(OTHER)
  openedAt   DateTime            @default(now())
  closedAt   DateTime?
  createdBy  String?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  org      Org                @relation(fields: [orgId], references: [id])
  customer Customer           @relation(fields: [customerId], references: [id])
  vehicle  Vehicle            @relation(fields: [vehicleId], references: [id])
  notes    WorkshopJobNote[]
  photos   WorkshopJobPhoto[]
  events   WorkshopJobEvent[]

  @@index([orgId, status])
  @@index([orgId, openedAt])
  @@index([customerId])
  @@index([vehicleId])
}

model WorkshopJobNote {
  id        String   @id @default(cuid())
  orgId     String
  jobId     String
  body      String
  createdBy String?
  createdAt DateTime @default(now())

  org Org         @relation(fields: [orgId], references: [id])
  job WorkshopJob @relation(fields: [jobId], references: [id])

  @@index([orgId])
  @@index([jobId])
}

model WorkshopJobPhoto {
  id           String            @id @default(cuid())
  orgId        String
  jobId        String
  fileName     String
  originalName String
  mimeType     String
  fileSize     Int
  photoType    WorkshopPhotoType @default(OTHER)
  uploadedBy   String?
  createdAt    DateTime          @default(now())

  org Org         @relation(fields: [orgId], references: [id])
  job WorkshopJob @relation(fields: [jobId], references: [id])

  @@index([orgId])
  @@index([jobId])
}

model WorkshopJobEvent {
  id        String            @id @default(cuid())
  orgId     String
  jobId     String
  eventType WorkshopEventType @default(OTHER)
  message   String?
  actor     String?
  createdAt DateTime          @default(now())

  org Org         @relation(fields: [orgId], references: [id])
  job WorkshopJob @relation(fields: [jobId], references: [id])

  @@index([orgId])
  @@index([jobId])
}

// =============================
// Sovereign Rentals v1
// =============================

enum RentalQuoteRequestStatus {
  NEW
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum RentalBookingStatus {
  PENDING
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum RentalDepositStatus {
  NOT_REQUIRED
  HELD
  RELEASED
  FORFEITED
}

enum RentalIssueType {
  DAMAGE
  LATE_RETURN
  PAYMENT
  OTHER
}

enum RentalIssuePriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum RentalIssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum RentalReminderType {
  PICKUP
  RETURN
  PAYMENT
  OTHER
}

enum RentalReminderStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

enum RentalEventType {
  BOOKING_CREATED
  STATUS_CHANGED
  PAYMENT_RECEIVED
  DOCUMENT_UPLOADED
  ISSUE_REPORTED
  NOTE
  OTHER
}

enum RentalDocumentType {
  AGREEMENT
  INVOICE
  RECEIPT
  ID_DOCUMENT
  VEHICLE_DOCUMENT
  OTHER
}

enum RentalMessageDirection {
  INBOUND
  OUTBOUND
}

enum RentalMessageChannel {
  WHATSAPP
  SMS
  EMAIL
  CALL
  OTHER
}

model RentalQuoteRequest {
  id String @id @default(cuid())
  orgId String
  customerId String?
  fullName String
  whatsappPhone String
  requestedCategory String?
  requestedVehicle String?
  startDate DateTime?
  endDate DateTime?
  pickupLocation String?
  dropoffLocation String?
  source String?
  status RentalQuoteRequestStatus @default(NEW)
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org Org @relation(fields: [orgId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])

  bookings RentalBooking[] @relation("RentalQuoteRequestToBooking")

  @@index([orgId, createdAt])
  @@index([orgId, status])
  @@index([customerId])
}

model RentalBooking {
  id String @id @default(cuid())
  orgId String
  customerId String
  vehicleId String?
  quoteRequestId String?
  reservationCode String
  agreementNumber String?
  invoiceNumber String?
  startDate DateTime
  endDate DateTime
  pickupLocation String?
  dropoffLocation String?
  totalAmount Int?
  currency String @default("AED")
  bookingStatus RentalBookingStatus @default(PENDING)
  depositAmount Int?
  depositStatus RentalDepositStatus @default(NOT_REQUIRED)
  salikNotes String?
  fineNotes String?
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org Org @relation(fields: [orgId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id])
  quoteRequest RentalQuoteRequest? @relation("RentalQuoteRequestToBooking", fields: [quoteRequestId], references: [id])
  documents RentalDocument[]
  deposits RentalDeposit[]
  issues RentalIssue[]
  reminders RentalReminder[]
  events RentalEvent[]
  messageLogs RentalMessageLog[]

  @@unique([orgId, reservationCode])
  @@index([orgId, bookingStatus])
  @@index([orgId, startDate])
  @@index([orgId, endDate])
  @@index([customerId])
  @@index([vehicleId])
}

model RentalDocument {
  id String @id @default(cuid())
  orgId String
  bookingId String?
  customerId String?
  documentType RentalDocumentType
  fileName String
  originalName String
  fileUrl String
  mimeType String
  fileSize Int
  uploadedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org Org @relation(fields: [orgId], references: [id])
  booking RentalBooking? @relation(fields: [bookingId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])

  @@index([orgId, createdAt])
  @@index([bookingId])
  @@index([customerId])
}

model RentalDeposit {
  id String @id @default(cuid())
  orgId String
  bookingId String
  amount Int
  currency String @default("AED")
  status RentalDepositStatus @default(HELD)
  heldAt DateTime?
  releasedAt DateTime?
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org Org @relation(fields: [orgId], references: [id])
  booking RentalBooking @relation(fields: [bookingId], references: [id])

  @@index([orgId, createdAt])
  @@index([bookingId])
  @@index([orgId, status])
}

model RentalIssue {
  id String @id @default(cuid())
  orgId String
  bookingId String?
  customerId String?
  issueType RentalIssueType
  description String
  priority RentalIssuePriority @default(NORMAL)
  status RentalIssueStatus @default(OPEN)
  reportedAt DateTime @default(now())
  resolvedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org Org @relation(fields: [orgId], references: [id])
  booking RentalBooking? @relation(fields: [bookingId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])

  @@index([orgId, reportedAt])
  @@index([orgId, status])
  @@index([bookingId])
  @@index([customerId])
}

model RentalMessageLog {
  id String @id @default(cuid())
  orgId String
  bookingId String?
  customerId String?
  direction RentalMessageDirection
  channel RentalMessageChannel @default(WHATSAPP)
  templateName String?
  messageText String
  deliveryStatus String?
  sentAt DateTime?
  deliveredAt DateTime?
  readAt DateTime?
  createdAt DateTime @default(now())

  org Org @relation(fields: [orgId], references: [id])
  booking RentalBooking? @relation(fields: [bookingId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])

  @@index([orgId, createdAt])
  @@index([bookingId])
  @@index([customerId])
}

model RentalReminder {
  id String @id @default(cuid())
  orgId String
  bookingId String
  reminderType RentalReminderType
  scheduledFor DateTime
  status RentalReminderStatus @default(PENDING)
  lastAttemptAt DateTime?
  sentAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org Org @relation(fields: [orgId], references: [id])
  booking RentalBooking @relation(fields: [bookingId], references: [id])

  @@index([orgId, scheduledFor])
  @@index([bookingId])
  @@index([orgId, status])
}

model RentalEvent {
  id String @id @default(cuid())
  orgId String
  bookingId String?
  customerId String?
  eventType RentalEventType
  message String?
  metadataJson Json?
  createdBy String?
  createdAt DateTime @default(now())

  org Org @relation(fields: [orgId], references: [id])
  booking RentalBooking? @relation(fields: [bookingId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])

  @@index([orgId, createdAt])
  @@index([bookingId])
  @@index([customerId])
}
